# Build output
bin/
obj/
out/
build/
build-tests/
x64/
Win32/
Debug/
Release/
*.dll
*.asi
*.exe
*.pdb
*.lib
*.exp
*.ilk

# Vendored third-party binaries (overrides *.dll/*.exe above)
!vendor/**/*.dll
!vendor/**/*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# IDE
.vs/
.vscode/
.idea/
*.user
*.vcxproj.user
*.suo

# Game libs (referenced at build time, never committed)
libs/

# Release packaging
release/
dist/

# Per-game install state
.headtracking-state.json

# Pixi
.pixi/

# Reverse-engineering material. The game EXE and anything derived from it
# (Ghidra projects, disassembly and decompilation dumps, memory captures) are
# the publisher's copyrighted code and must never enter this repo, even
# ignored. Keep the RE workspace outside the repo tree - C:/Data/re/<game>.
# Only derived facts (RVAs, struct offsets, PE fingerprints) come back in, in
# src/build_profile.cpp.
*.gpr
*.rep/
ghidra/
*.gzf
*.idb
*.i64
*.dmp

# Screenshots and screen recordings. Desktop captures leak whatever else was
# on screen, so they never get committed casually; deliberate README media
# lives in assets/ and is exempt below.
*.png
*.jpg
*.jpeg
*.gif
*.mp4
!assets/**

# AI tooling and local notes
.claude/
.lab/
.millhouse/
AGENTS.md
CLAUDE.md
NEXUS_MODS.md

# MCP servers
.mcp/
.mcp.json
*.mcp.json
mcp-servers/

# OS
.DS_Store
Thumbs.db
